"""Python type declarations for the oxlsx PyO3 extension."""

from datetime import date, datetime, time, timedelta
from typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple, Union

_CellValue = Optional[Union[bool, str, int, float, date, datetime, time, timedelta]]
_CellRow = Tuple[Cell, ...]
_CellValueRow = Tuple[_CellValue, ...]


def load_workbook(path: str) -> Workbook: ...
def get_column_letter(idx: int) -> str: ...
def column_index_from_string(letter: str) -> int: ...
def dataframe_to_rows(df: Any, index: bool = ..., header: bool = ...) -> List[List[Any]]: ...


class Workbook:
    def __init__(self) -> None: ...

    @property
    def worksheets(self) -> List[Worksheet]: ...

    @property
    def sheetnames(self) -> List[str]: ...

    @property
    def active(self) -> Optional[Worksheet]: ...

    def __getitem__(self, title: str) -> Worksheet: ...
    def save(self, path: str) -> None: ...

    @property
    def defined_names(self) -> DefinedNames: ...


class DefinedName:
    def __init__(
        self, name: str, value: str, *, comment: Optional[str] = ..., hidden: bool = ...
    ) -> None: ...

    @property
    def name(self) -> str: ...

    @property
    def value(self) -> str: ...

    @property
    def comment(self) -> Optional[str]: ...

    @property
    def hidden(self) -> bool: ...

    @property
    def is_reserved(self) -> Optional[bool]: ...

    @property
    def localSheetId(self) -> Optional[int]: ...


class DefinedNames:
    def add(self, defined_name: DefinedName) -> None: ...
    def __getitem__(self, name: str) -> DefinedName: ...
    def __setitem__(self, name: str, defined_name: DefinedName) -> None: ...
    def __delitem__(self, name: str) -> None: ...
    def __contains__(self, name: object) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def keys(self) -> List[str]: ...


class Worksheet:
    @property
    def title(self) -> str: ...

    def __getitem__(self, coord: str) -> Cell: ...
    def __setitem__(self, coord: str, value: _CellValue) -> None: ...
    def cell(self, *, row: int, column: int) -> Cell: ...

    @property
    def max_row(self) -> int: ...

    @property
    def max_column(self) -> int: ...

    @property
    def min_row(self) -> int: ...

    @property
    def min_column(self) -> int: ...

    def iter_rows(
        self,
        min_row: Optional[int] = ...,
        max_row: Optional[int] = ...,
        min_col: Optional[int] = ...,
        max_col: Optional[int] = ...,
        values_only: bool = ...,
    ) -> List[Union[_CellRow, _CellValueRow]]: ...

    def iter_cols(
        self,
        min_col: Optional[int] = ...,
        max_col: Optional[int] = ...,
        min_row: Optional[int] = ...,
        max_row: Optional[int] = ...,
        values_only: bool = ...,
    ) -> List[Union[_CellRow, _CellValueRow]]: ...

    @property
    def rows(self) -> List[_CellRow]: ...

    @property
    def columns(self) -> List[_CellRow]: ...

    @property
    def values(self) -> List[_CellValueRow]: ...

    def merge_cells(self, range: str) -> None: ...
    def unmerge_cells(self, range: str) -> None: ...
    def column_width(self, col: int, width: float) -> None: ...
    def row_height(self, row: int, height: float) -> None: ...
    def set_cell_comment(self, coord: str, text: str, author: str) -> None: ...
    def set_cell_hyperlink(self, coord: str, target: str) -> None: ...
    def set_cell_fill(self, coord: str, fill: PatternFill) -> None: ...

    @property
    def freeze_panes(self) -> Optional[str]: ...

    @freeze_panes.setter
    def freeze_panes(self, value: Optional[str]) -> None: ...

    @property
    def print_area(self) -> Optional[str]: ...

    @print_area.setter
    def print_area(self, value: Optional[str]) -> None: ...

    @property
    def print_title_rows(self) -> Optional[str]: ...

    @print_title_rows.setter
    def print_title_rows(self, value: Optional[str]) -> None: ...

    @property
    def print_title_cols(self) -> Optional[str]: ...

    @print_title_cols.setter
    def print_title_cols(self, value: Optional[str]) -> None: ...

    @property
    def defined_names(self) -> DefinedNames: ...

    @property
    def tables(self) -> _TableList: ...

    @property
    def auto_filter(self) -> AutoFilter: ...

    @property
    def conditional_formatting(self) -> ConditionalFormatting: ...

    def add_table(self, table: Table) -> None: ...
    def append(self, iterable: Union[Iterable[_CellValue], Dict[Union[str, int], _CellValue]]) -> None: ...
    def insert_rows(self, idx: int, amount: int = ...) -> None: ...
    def delete_rows(self, idx: int, amount: int = ...) -> None: ...
    def insert_cols(self, idx: int, amount: int = ...) -> None: ...
    def delete_cols(self, idx: int, amount: int = ...) -> None: ...
    def move_range(
        self, cell_range: str, rows: int = ..., cols: int = ..., translate: bool = ...
    ) -> None: ...


class AutoFilter:
    @property
    def ref(self) -> Optional[str]: ...

    @ref.setter
    def ref(self, value: Optional[str]) -> None: ...


class FormulaRule:
    def __init__(
        self,
        formula: Optional[List[str]] = ...,
        stopIfTrue: bool = ...,
        font: Optional[Font] = ...,
        fill: Optional[PatternFill] = ...,
    ) -> None: ...


class CellIsRule:
    def __init__(
        self,
        operator: Optional[str] = ...,
        formula: Optional[List[str]] = ...,
        stopIfTrue: bool = ...,
        font: Optional[Font] = ...,
        fill: Optional[PatternFill] = ...,
    ) -> None: ...


class ConditionalFormatting:
    def add(self, sqref: str, rule: Union[FormulaRule, CellIsRule]) -> None: ...


class Cell:
    @property
    def value(self) -> _CellValue: ...

    @property
    def font(self) -> Optional[Font]: ...

    @property
    def fill(self) -> Optional[Fill]: ...

    @property
    def comment(self) -> Optional[Comment]: ...

    @property
    def hyperlink(self) -> Optional[Hyperlink]: ...

    @property
    def row(self) -> int: ...

    @property
    def column(self) -> int: ...


class Comment:
    @property
    def text(self) -> str: ...

    @property
    def author(self) -> str: ...


class Hyperlink:
    @property
    def target(self) -> Optional[str]: ...

    @property
    def location(self) -> Optional[str]: ...

    @property
    def tooltip(self) -> Optional[str]: ...

    @property
    def display(self) -> Optional[str]: ...


class TableStyleInfo:
    def __init__(
        self,
        name: str,
        *,
        showFirstColumn: bool = ...,
        showLastColumn: bool = ...,
        showRowStripes: bool = ...,
        showColumnStripes: bool = ...,
    ) -> None: ...

    @property
    def name(self) -> str: ...

    @property
    def showFirstColumn(self) -> bool: ...

    @property
    def showLastColumn(self) -> bool: ...

    @property
    def showRowStripes(self) -> bool: ...

    @property
    def showColumnStripes(self) -> bool: ...


class TableColumn:
    @property
    def id(self) -> int: ...

    @property
    def name(self) -> str: ...


class Table:
    def __init__(self, displayName: str, ref: str) -> None: ...

    @property
    def displayName(self) -> str: ...

    @property
    def name(self) -> str: ...

    @property
    def ref(self) -> str: ...

    @property
    def tableColumns(self) -> List[TableColumn]: ...

    @property
    def tableStyleInfo(self) -> Optional[TableStyleInfo]: ...

    @tableStyleInfo.setter
    def tableStyleInfo(self, value: Optional[TableStyleInfo]) -> None: ...


class _TableList:
    def __getitem__(self, name: str) -> Table: ...
    def __delitem__(self, name: str) -> None: ...
    def __contains__(self, name: object) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def keys(self) -> List[str]: ...


class Font:
    @property
    def bold(self) -> bool: ...

    @property
    def italic(self) -> bool: ...

    @property
    def strike(self) -> bool: ...

    @property
    def color(self) -> Optional[Color]: ...


class Fill:
    @property
    def fg_color(self) -> Optional[Color]: ...

    @property
    def start_color(self) -> Optional[Color]: ...

    @property
    def end_color(self) -> Optional[Color]: ...


class PatternFill:
    def __init__(
        self,
        fill_type: Optional[str] = ...,
        fgColor: Optional[str] = ...,
        bgColor: Optional[str] = ...,
        start_color: Optional[str] = ...,
        end_color: Optional[str] = ...,
        patternType: Optional[str] = ...,
    ) -> None: ...

    @property
    def fill_type(self) -> Optional[str]: ...

    @property
    def patternType(self) -> Optional[str]: ...

    @property
    def fgColor(self) -> Optional[Color]: ...

    @property
    def bgColor(self) -> Optional[Color]: ...

    @property
    def start_color(self) -> Optional[Color]: ...

    @property
    def end_color(self) -> Optional[Color]: ...


class Color:
    @property
    def rgb(self) -> Optional[str]: ...

    @property
    def theme(self) -> Optional[int]: ...

    @property
    def indexed(self) -> Optional[int]: ...

    @property
    def tint(self) -> Optional[float]: ...
